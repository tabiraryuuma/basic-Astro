---
import Layout from "../layouts/Layout.astro";
import "../styles/pages/contact.scss";
---

<Layout>
	<main>
		<section class="ContactPage">
			<div class="ContactPage__HEAD">
				<h1>CONTACT</h1>
				<p>お問い合わせ</p>
			</div>

			<form
				id="Contact"
				action="/contact-complete/"
				method="post"
				class="ContactPage__form"
			>
				<dl class="textbox">
					<dt><label for="name">お名前</label><span>※</span></dt>
					<dd>
						<input type="text" id="name" name="name" />
						<span id="name-error"></span>
					</dd>
				</dl>
				<dl class="textbox">
					<dt><label for="furigana">ふりがな</label><span>※</span></dt>
					<dd>
						<input type="text" id="furigana" name="furigana" />
						<span id="furigana-error"></span>
					</dd>
				</dl>
				<dl class="textbox">
					<dt><label for="email">メールアドレス</label><span>※</span></dt>
					<dd>
						<input type="email" id="email" name="email" />
						<span id="email-error"></span>
					</dd>
				</dl>
				<dl class="textbox">
					<dt><label for="tel-number">電話番号</label></dt>
					<dd>
						<input type="text" id="tel" name="tel" />
					</dd>
				</dl>
				<dl class="textbox">
					<dt><label for="time">ご連絡可能な曜日・時間帯</label></dt>
					<dd>
						<input type="text" id="time" name="time" />
					</dd>
				</dl>
				<dl class="addressbox">
					<dt><label for="address">ご住所</label></dt>
					<dd>
						<div>
							<input type="text" id="zipcode" name="address" />
						</div>

						<div>
							<button type="button" id="searchBox">住所自動入力</button>
						</div>

						<div>
							<label for="address"></label>
							<input type="text" id="address" name="address" />
						</div>
					</dd>
				</dl>
				<dl class="textbox">
					<dt><label for="inquiry">お問い合わせ内容</label><span>※</span></dt>
					<dd>
						<textarea id="inquiry"></textarea>
						<span id="inquiry-error"></span>
					</dd>
				</dl>

				<a href="">プライバシーポリシーはコチラ</a>
				<p>
					<input
						type="checkbox"
						id="check"
						name="check"
						value="privacy-police"
					/><label for="check">プライバシーポリシーに同意する</label>
					<span id="checkbox-error"></span>
				</p>
				<p>
					<input type="submit" onclick="dummyPost ()" value="送信する" />
				</p>
			</form>
		</section>
	</main>
</Layout>

<script>
	const zipcode = document.querySelector("#zipcode") as HTMLInputElement;
	const button = document.querySelector("#searchBox") as HTMLInputElement;
	const address = document.querySelector("#address") as HTMLInputElement;

	button?.addEventListener("click", async () => {
		const zip = zipcode?.value.replace("-", "");
		if (!zip) {
			alert("郵便番号を入力してください。");
			return;
		}

		try {
			const response = await fetch(
				`https://zipcloud.ibsnet.co.jp/api/search?zipcode=${zip}`,
			);

			const data = await response.json();

			if (data.results) {
				const result = data.results[0];

				address.value = result.address1 + result.address2 + result.address3;
			} else {
				alert("住所が見つかりませんでした。");
			}
		} catch (error) {
			alert("通信エラーが発生しました。");
			console.error(error);
		}
	});

	document
		.getElementById("Contact")!
		.addEventListener("submit", function (event) {
			const usernameField = document.getElementById("name") as HTMLInputElement;

			const errorMessage1 = document.getElementById(
				"name-error",
			) as HTMLInputElement;

			if (!usernameField.value.trim()) {
				event.preventDefault();
				errorMessage1.textContent = "必須項目です。";
			} else {
				errorMessage1.textContent = "";
			}

			const userfuriganaField = document.getElementById(
				"furigana",
			) as HTMLInputElement;

			const errorMessage2 = document.getElementById(
				"furigana-error",
			) as HTMLInputElement;

			if (!userfuriganaField.value.trim()) {
				event.preventDefault();
				errorMessage2.textContent = "必須項目です。";
			} else {
				errorMessage2.textContent = "";
			}

			const useremailField = document.getElementById(
				"email",
			) as HTMLInputElement;

			const errorMessage3 = document.getElementById(
				"email-error",
			) as HTMLInputElement;

			if (!useremailField.value.trim()) {
				event.preventDefault();
				errorMessage3.textContent = "必須項目です。";
			} else {
				errorMessage3.textContent = "";
			}

			const userinquiryField = document.getElementById(
				"inquiry",
			) as HTMLInputElement;

			const errorMessage4 = document.getElementById(
				"inquiry-error",
			) as HTMLInputElement;

			if (!userinquiryField.value.trim()) {
				event.preventDefault();
				errorMessage4.textContent = "必須項目です。";
			} else {
				errorMessage4.textContent = "";
			}

			const usercheckField = document.getElementById(
				"check",
			) as HTMLInputElement;

			const errorMessage5 = document.getElementById(
				"checkbox-error",
			) as HTMLInputElement;

			if (!usercheckField.checked) {
				event.preventDefault();
				errorMessage5.textContent = "同意されていません。";
			} else {
				errorMessage5.textContent = "";
			}
		});
</script>
