---
import Layout from "../layouts/Layout.astro";
import "../styles/style.scss";
import "../styles/pages/Itoshima810.scss";
import ImageSwitcher from '../components/ImageSwitcher.astro';

import Card from '../components/Card.astro';
import ReserveButton from '../components/ReserveButton.astro';---
<Layout>
  <main>
    <section class="itoshima810" id="site-itoshima810">
      <div class="itoshima810__content">
        <div class="itoshima810__mainvisual">
          <img
          class="hero__image"
          src="/src/assets/image/Itoshima810/Itoshima810mv-Daytlme.webp"        
          alt="メインビジュアル"
          />
        <div class="itoshima810__logo">
          <img 
          src="/src/assets/SVG/itoshima810.svg" 
          alt="itoshima810のロゴ">
        </div>
    </section>

   <section class="itoshima810__Villa-Resort">
    
    <h1 class="itoshima810__title">
      思い思いの時間を過ごす、
      <br>
      集うホテル。
    </h1>

    <!-- 画像 -->
    <h1 class="itoshima810__catch">
      <img
      class="itoshima810__hero-title"
      src="src/assets/image/Itoshima810/itoshima810-Villa-Resort.svg"
      alt="itoshima810 Villa＆Resort"
      />
    </h1>

    <p class="itoshima810__Villa-Resort-text">
      大人数でも、ゆったりとくつろげる。
      <br>
      のびやかな余白が心をほどく、糸島のヴィラリゾート。
    </p>

    <div class="itoshima810__reservation-button">
      <ReserveButton/>    
    </div>
   </section>
   
   <div class="itoshima810__visual">
    <img
    class="itoshima810__villa-inner"
    src="/src/assets/image/Itoshima810/2Itoshima810-Daytlme.webp"
    data-day-src="/src/assets/image/Itoshima810/2Itoshima810-Daytlme.webp"
    data-night-src="/src/assets/image/Itoshima810/2Itoshima810-NIGHTTIME.webp"
    alt="メインビジュアル"
    />
    </div>

    <section class="itoshima810__villa-concept">
      <div class="itoshima810__switcher">
        <ImageSwitcher />
      </div>

      <div class="toshima810__villa-title">
        <img
        class="itoshima810__hero-title"
        src="src/assets/image/Itoshima810/itoshima810.svg"
        alt="Itoshima810"
        />
      </div>
      
      <div class="toshima810__villa-text">
        <p>
          糸島の自然に囲まれた、広々とした敷地に佇む一棟。
          <br>
          季節の移ろいを肌で感じるプライベートガーデン。
        </p>

        <p>
          大人数でもゆったりくつろげる、
          <br>
          空間に合わせてデザイン家具を設えたリビングで
          <br>
          穏やかな時間をお過ごしください。
          <br>
          <br>
        </p>

        <p>
          にぎやかな語らいも、静けさも、
          <br>
          すべてが心地よく流れていく。
          <br>
          大切な人たちと集い、過ごすためのホテルです。
        </p>
        
        
        <!-- ② 画像1 (PRIVATE GARDEN) -->
        <figure class="gallery-layout__item gallery-layout__item--prlvate">
          <span class="gallery-layout__label">PRIVATE GARDEN</span>
           <div class="gallery-layout__img-wrap">
            <img 
            src="src/assets/image/Itoshima810/3Itoshima810-Daytlme.webp" 
            data-day-src="src/assets/image/Itoshima810/3Itoshima810-Daytlme.webp" 
            data-night-src="src/assets/image/Itoshima810/3Itoshima810-NIGHTTIME.webp" 
            alt=" "
            
            />
            </div>
         </figure>

        <!-- ③ 画像2 (ENGAWA) -->
        <figure class="gallery-layout__item gallery-layout__item--engawa">
          <span class="gallery-layout__label">ENGAWA</span>
          <div class="gallery-layout__img-wrap">

            <img 
            src="src/assets/image/Itoshima810/4Itoshima810-Daytlme.webp" 
            data-day-src="src/assets/image/Itoshima810/4Itoshima810-Daytlme.webp" 
            data-night-src="src/assets/image/Itoshima810/4Itoshima810-NIGHTTIME.webp" 
            alt=" "
            
            />

            </div>
        </figure>

        <!-- ④ 画像3 (LIVING ROOM) -->
        <figure class="gallery-layout__item gallery-layout__item--living">
          <span class="gallery-layout__label">LIVING ROOM</span>
          <div class="gallery-layout__img-wrap">
            <img 
            src="" 
            data-day-src="" 
            data-night-src="" 
            alt=" "
            
            />

            </div>
        </figure>











      </div>
    </section>



</main>


</Layout>