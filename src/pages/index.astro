---
import Layout from "../layouts/Layout.astro";
// Layout.astro = ページの共通テンプレ（外枠）
// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
import "../styles/pages/_index.scss";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import ReserveButton from "../components/ReserveButton.astro";
import ReserveButtonFix from "../components/ReserveButtonFix.astro";

import * as Top from "../assets/image/top";
import * as CommonIcons from "../assets/SVG";
---

<Layout>
  <main>
    <div class="mainvisual">
      <ul class="mainvisual__fade-img">
        <li>
          <picture>
            <source
              srcset={Top.TopMainvisual1sp.src}
              media="(max-width: 1023px)"
            />
            <img
              src={Top.TopMainvisual1.src}
              alt=""
              width="100%"
              height="100%"
            />
          </picture>
        </li>
        <li>
          <picture>
            <source
              srcset={Top.TopMainvisual2sp.src}
              media="(max-width: 1023px)"
            />
            <img
              src={Top.TopMainvisual2.src}
              alt=""
              width="100%"
              height="100%"
            />
          </picture>
        </li>
        <li>
          <picture>
            <source
              srcset={Top.TopMainvisual3sp.src}
              media="(max-width: 1023px)"
            />
            <img
              src={Top.TopMainvisual3.src}
              alt=""
              width="100%"
              height="100%"
            />
          </picture>
        </li>
        <li>
          <picture>
            <source
              srcset={Top.TopMainvisual4sp.src}
              media="(max-width: 1023px)"
            />
            <img
              src={Top.TopMainvisual4.src}
              alt=""
              width="100%"
              height="100%"
            />
          </picture>
        </li>
        <li>
          <picture>
            <source
              srcset={Top.TopMainvisual5sp.src}
              media="(max-width: 1023px)"
            />
            <img
              src={Top.TopMainvisual5.src}
              alt=""
              width="100%"
              height="100%"
            />
          </picture>
        </li>
        <li>
          <picture>
            <source
              srcset={Top.TopMainvisual6sp.src}
              media="(max-width: 1023px)"
            />
            <img
              src={Top.TopMainvisual6.src}
              alt=""
              width="100%"
              height="100%"
            />
          </picture>
        </li>
      </ul>

      <div class="mainvisual__logo">
        <img src={Top.Designoffice.src} alt="" />
      </div>
      <p class="mainvisual__catchphrase">
        <span class="margin">RETREAT</span>PROJECT
      </p>
      <h1 class="mainvisual__title">YONEDA HOTEL GROUP</h1>
    </div>

    <ReserveButtonFix />

    <section id="mainvisual-top1">
      <div class="mainvisual2">
        <div class="Project">
          <!-- MT=mainvisual top -->
          <h2 class="Mt-h2">PROJECT</h2>
          <nav class="item">
            <ul>
              <li>
                <a href="/Itoshima810/"
                  ><img src={CommonIcons.Itoshima810.src} alt="" /></a
                >
              </li>
              <li>
                <a href="/Itoshima808/"
                  ><img src={CommonIcons.Itoshima8081.src} alt="" /></a
                >
              </li>
            </ul>
            <ul>
              <li><a href="#">Tamagawa4</a></li>
              <li><a href="#">Okusu3</a></li>
            </ul>
          </nav>
          <nav class="button-group">
            <Button
              href="/project/"
              text="PROJECT 一覧"
              variant="transparent"
            />
            <ReserveButton />
          </nav>
        </div>
        <div class="Movie">
          <h2 class="Mt-h2">MOVIE</h2>
          <nav>
            <ul>
              <li><img src={CommonIcons.動画再生アイコン.src} /></li>
              <li>itoshima810 VILLA & RESORT</li>
            </ul>
            <ul>
              <li><img src={CommonIcons.動画再生アイコン.src} /></li>
              <li>Itoshima808 GRAND VIEW VILLA</li>
            </ul>
          </nav>
        </div>
      </div>
      <div class="mainvisual1">
        <h1 class="heading">
          ただ泊まるだけではない、<span class="br"></span>記憶に残るひとときを。
        </h1>

        <p class="gradation">
          <span class="block"> 時間とともに表情を変える空間の中で、</span><span
            class="br"></span>気持ちがゆるやかにほどけていく。<span class="br"
          ></span>日常から少し離れ、ただ過ぎゆく時を愉しむ。<span class="br"
          ></span><span class="pc-only"
            >その場所ごとに込めた思いと心地よさが溶け合う、</span
          >
          <span class="sp-only"
            >その場所ごとに込めた思いと<span class="br"
            ></span>心地よさが溶け合う、</span
          ><span class="br"></span><span class="block"
            >くつろぎの滞在をお楽しみください。</span
          >
        </p>
      </div>
    </section>
  </main>

  <section id="mainvisual-top2">
    <div class="media">
      <h2 class="Mt-h2">MEDIA</h2>
      <div class="magazine">
        <ul>
          <li></li>
          <li>掲載雑誌名</li>
        </ul>
        <ul>
          <li></li>
          <li>掲載雑誌名</li>
        </ul>
      </div>
    </div>

    <div class="STAY-in-DESIGN">
      <div class="scroll-infinity">
        <div class="scroll-infinity__wrap">
          <ul class="scroll-infinity__list scroll-infinity__list--left">
            <li class="scroll-infinity__item">
              <img src={Top.Image2Slide1.src} />
            </li>
            <li class="scroll-infinity__item">
              <img src={Top.Image2Slide2.src} />
            </li>
            <li class="scroll-infinity__item">
              <img src={Top.Image2Slide3.src} />
            </li>
            <li class="scroll-infinity__item">
              <img src={Top.Image2Slide4.src} />
            </li>
            <li class="scroll-infinity__item">
              <img src={Top.Image2Slide5.src} />
            </li>
            <li class="scroll-infinity__item">
              <img src={Top.Image2Slide6.src} />
            </li>
            <li class="scroll-infinity__item">
              <img src={Top.Image2Slide7.src} />
            </li>
            <li class="scroll-infinity__item">
              <img src={Top.Image2Slide8.src} />
            </li>
          </ul>
          <ul class="scroll-infinity__list scroll-infinity__list--left">
            <li class="scroll-infinity__item">
              <img src={Top.Image2Slide1.src} />
            </li>
            <li class="scroll-infinity__item">
              <img src={Top.Image2Slide2.src} />
            </li>
            <li class="scroll-infinity__item">
              <img src={Top.Image2Slide3.src} />
            </li>
            <li class="scroll-infinity__item">
              <img src={Top.Image2Slide4.src} />
            </li>
            <li class="scroll-infinity__item">
              <img src={Top.Image2Slide5.src} />
            </li>
            <li class="scroll-infinity__item">
              <img src={Top.Image2Slide6.src} />
            </li>
            <li class="scroll-infinity__item">
              <img src={Top.Image2Slide7.src} />
            </li>
            <li class="scroll-infinity__item">
              <img src={Top.Image2Slide8.src} />
            </li>
          </ul>
        </div>
      </div>

      <div class="text-area">
        <h1>STAY in DESIGN.</h1>
        <p>
          <span
            >produced by<br /><img src={Top.Designoffice.src} alt="" />
          </span>
        </p>
        <p class="short-sentence pc-only">
          設計事務所ならではの視点で、デザイン性と居心地の良さ、<span class="br"
          ></span>そして日常から少し離れる非日常感を大切にしています。
        </p>
        <p class="short-sentence sp-only">
          設計事務所ならではの視点で、<span class="br"
          ></span>デザイン性と居心地の良さ、<span class="br"
          ></span>そして日常から少し離れる<span class="br"
          ></span>非日常感を大切にしています。
        </p>

        <ul>
          <li>
            <Button href="/about/" text="ABOUT" variant="transparent" />
          </li>
          <li>
            <a href="#"><p>ホテルづくりをお考えの方へ</p><p>&gt;</p></a>
          </li>
        </ul>
      </div>
      <img class="bottom-image" src={Top.Image2About.src} alt="" />
    </div>
  </section>
</Layout>
