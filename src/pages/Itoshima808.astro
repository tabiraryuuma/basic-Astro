---
import Layout from "../layouts/Layout.astro";

import "../styles/pages/Itoshima808.scss";

// 画像のインポート
import * as ImagesItoshima808 from "../assets/image/Itoshima808";
import * as CommonIcons from "../assets/SVG";
import * as ImagesItoshima810 from "../assets/image/Itoshima810";

// 部品のインポート
import ReserveButton from "../components/ReserveButton.astro";
import ReserveButtonFix from "../components/ReserveButtonFix.astro";
import ImageSwitcher from "../components/ImageSwitcher.astro";

---

<Layout title = "Itoshima808", description = "これはItoshima808のページです">

  <main>
    <div class="itoshima808__content">
      <div class="itoshima808__mainvisual">
         <img
          class="hero__image"
          src={ImagesItoshima808.Itoshima808MovieShort.src}       
          alt="Itoshima808ショート動画"
          />        
      </div>
      <div class="itoshima808__logo">
        <img
          class="hero__image"
          src={CommonIcons.Itoshima8081.src}       
          alt="Itoshima808ロゴ"
          />          
      </div>
    </div>

    <ReserveButtonFix />

    <section class="itoshima808__concept">
      <div class="itoshima808__concept__content l-container">
        <h2 class="itoshima808__concept__title">
          海と空を、<br class="sp-only">独り占めする滞在。
        </h2>

        <h1 class="itoshima808__concept__catch">
          <img
          class="itoshima808__hero-title"
          src={ImagesItoshima810.Itoshima810VillaResort.src}       
          alt=""
          />        
        </h1>

        <p class="itoshima808__concept__text">
          絶景が日常を遠ざける。<br>
          心地よさに身を委ねる、<br class="sp-only">
          糸島のグランドビュー。
        </p>

        <div class="itoshima808__reservation-button">
          <ReserveButton />    
        </div>       
      </div>
    </section>

    <section class="itoshima808__day-night">
      <div class="itoshima808__visual">
        <img
          class="itoshima808__villa-inner"
          src={ImagesItoshima808.Itoshima808Day1.src} 
          data-day-src={ImagesItoshima808.Itoshima808Day1.src} 
          data-night-src={ImagesItoshima808.Itoshima808Night1.src}  
          alt="メインビジュアル"
          />        
      </div>

      <div class="itoshima808__switcher">
        <ImageSwitcher />
      </div>

      <!-- Villa（KITCHEN・BED ROOM・PRIVATE GARDEN） -->

      <div class="itoshima808__villa">

        <div class="itoshima808__villa__text">
          <h2 class="itoshima808__villa__text__title">ITOSHIMA808</h2>
          <div class="itoshima808__villa__text__description">
            <p class="itoshima808__villa__text__description__parts">特徴的な三角形の外観が印象的な、海を望むヴィラ。<br>寝室やバルコニーから広がる景色が、<br>
                滞在の時間そのものを特別なものに変えていきます。
            </p>
            <p class="itoshima808__villa__text__description__parts">バルコニーとつながるリビングに、<br>心地よい風が通り抜ける。<br>
                無駄を削ぎ落としたコンパクトな設えに、<br>必要な設備を丁寧に整えました。
            </p>
            <p class="itoshima808__villa__text__description__parts">南国植物に囲まれたプライベートガーデンで<br>焚き火を囲み、静かに語らうひととき。<br>
                波の音を聴きながら、まどろみの中へ。<br>心が満たされる、贅沢なひとときをお過ごしください。
            </p>
          </div>
        </div>

        <div class="itoshima808__villa__imgtop">
          <div class="itoshima808__villa__imgtop__item itoshima808__villa__imgtop__item--left">
            <figure>
              <img
                class="itoshima808__villa__imgtop__left"
                src={ImagesItoshima808.Itoshima808Day3.src}
                data-day-src={ImagesItoshima808.Itoshima808Day3.src}
                data-night-src={ImagesItoshima808.Itoshima808Night3.src}              
                alt="" 
                />            
              <figcaption>BED ROOM</figcaption>
            </figure>
          </div>
          <div class="itoshima808__villa__imgtop__item itoshima808__villa__imgtop__item--right">
            <figure>
              <img
                class="itoshima808__villa__imgtop__right"
                src={ImagesItoshima808.Itoshima808Day2.src}
                data-day-src={ImagesItoshima808.Itoshima808Day2.src}
                data-night-src={ImagesItoshima808.Itoshima808Night2.src}              
                alt="" 
                />            
              <figcaption>KITCHEN</figcaption>
            </figure>
          </div>
        </div>
        
        <div class="itoshima808__villa__imgBottom">
          <figure>
              <img
                class=""
                src={ImagesItoshima808.Itoshima808Day4.src}
                data-day-src={ImagesItoshima808.Itoshima808Day4.src}
                data-night-src={ImagesItoshima808.Itoshima808Night4.src}              
                alt="" 
                />            
              <figcaption>PRIVATE GARDEN</figcaption>
            </figure>
        </div>
      </div>

















    </section>














    
  </main>









</Layout>

