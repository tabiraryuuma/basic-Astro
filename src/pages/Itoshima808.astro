---
import Layout from "../layouts/Layout.astro";
// Layout.astro = ページの共通テンプレ（外枠）

// import "../styles/pages/_index.scss";
import "../styles/pages/Itoshima808.scss";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import ReserveButton from "../components/ReserveButton.astro";
import ReserveButtonFix from "../components/ReserveButtonFix.astro";
import ImageSwitcher from "../components/ImageSwitcher.astro";

// 画像パーツ（Imageコンポーネント）を読み込む
import { Image } from 'astro:assets';

// 使いたい画像を1枚ずつ名前をつけてインポートする
// (書き方: import [好きな名前] from '[画像がある場所へのパス]';)
import mainvisual from '../assets/images/Itoshima808/Itoshima808-movie-short.webp';
---

<Layout title = "Itoshima808", description = "これはItoshima808のページです">

  <main>
    <div class="itoshima808__content">
      <div class="itoshima808__mainvisual">
        <!-- <Image src= {mainvisual} alt="Itoshima808ショート動画" width={1920} /> -->
        <img src="/src/assets/image/Itoshima808/Itoshima808-movie-short.webp" alt="Itoshima808ショート動画">
        <!-- <picture>
          <source srcset="/src/assets/image/Itoshima808/Itoshima808-movie-shortsp.webp" media="(max-width: 1023px)">
          <img src="/src/assets/image/Itoshima808/Itoshima808-movie-short.webp" alt="Itoshima808ショート動画">
        </picture> -->
      </div>
      <div class="itoshima808__logo">
        <img src="/src/assets/SVG/Itoshima808-1.svg" alt="">
      </div>
    </div>

    <ReserveButtonFix />

    <section class="itoshima808__concept">
      <div class="itoshima808__concept__content l-container">
        <h2 class="itoshima808__concept__title">
          海と空を、<br class="sp-only">独り占めする滞在。
        </h2>

        <h1 class="itoshima808__concept__catch">
          <img
          class="itoshima810__hero-title"
          src="src/assets/image/Itoshima810/itoshima810-Villa-Resort.svg" alt="">
        </h1>

        <p class="itoshima808__concept__text">
          絶景が日常を遠ざける。<br>
          心地よさに身を委ねる、<br class="sp-only">
          糸島のグランドビュー。
        </p>

        <div class="itoshima808__reservation-button">
          <ReserveButton />    
        </div>       
      </div>
    </section>

    <section class="itoshima808__day-night">
      <div class="itoshima808__visual">
        <img class="itoshima810__villa-inner" src="/src/assets/image/Itoshima808/Itoshima808-day-1.webp"
          data-day-src="/src/assets/image/Itoshima808/Itoshima808-day-1.webp"
          data-night-src="/src/assets/image/Itoshima808/Itoshima808-night-1.webp"
          alt="メインビジュアル">
      </div>

      <div class="itoshima808__switcher">
        <ImageSwitcher />
      </div>

      <div class="itoshima808__villa">
               <!-- トップ -->
        <div class="villa-top">

          <div class="villa-top__text">
            <img class="villa-top__text__logo" src="/src/assets/SVG/itoshima810_1.svg" alt="">
            <p>特徴的な三角形の外観が印象的な、海を望むヴィラ。<br>寝室やバルコニーから広がる景色が、<br>
              滞在の時間そのものを特別なものに変えていきます。
            </p>
            <p>バルコニーとつながるリビングに、<br>心地よい風が通り抜ける。<br>
              無駄を削ぎ落としたコンパクトな設えに、<br>必要な設備を丁寧に整えました。
            </p>
            <p>南国植物に囲まれたプライベートガーデンで<br>焚き火を囲み、静かに語らうひととき。<br>
              波の音を聴きながら、まどろみの中へ。<br>心が満たされる、贅沢なひとときをお過ごしください。
            </p>            
          </div>

          <div class="villa-top__img">
            <figure>
              <img src="/src/assets/image/Itoshima808/Itoshima808-day-2.webp" 
                data-day-src="/src/assets/image/Itoshima808/Itoshima808-day-2.webp"
                data-night-src="/src/assets/image/Itoshima808/Itoshima808-night-2.webp"
                alt="">            
              <figcaption>KITCHEN</figcaption>
            </figure>
          </div>
        </div>





      </div>

















    </section>














    
  </main>









</Layout>

