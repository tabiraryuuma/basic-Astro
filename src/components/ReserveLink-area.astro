---
// import Card from "./Card.astro";
import "../styles/components/_ReserveLink-area.scss";

interface Props {
	text?: string;
	title1?: string;
	title2?: string;
	title3?: string;
	href1?: string;
	href2?: string;
	href3?: string;
}

const {
	text = "テキスト",
	title1 = "Airbnb",
	title2 = "Rakuten Oyado",
	title3 = "Booking.com",
	href1 = "#",
	href2 = "#",
	href3 = "#",
}: Props = Astro.props;
---

<div id="Reserve-Block" class="Reserve-Site-area">
	<div class="Reserve-Site-area__text">
		<p class="Reserve-Site-area__decoration">Reserve｜予約</p>
	</div>
	<p class="Reserve-Site-area__text-2">
		<span class="Reserve-Site-area__pc-only"
			>{text} のご予約は下記リンク、予約サイトより。</span
		>
		<span class="Reserve-Site-area__sp-only"
			>{text} のご予約は<br />下記リンク、予約サイトより。</span
		>
		<span class="Reserve-Site-area__br">詳細は各サイトにてご確認ください。</span
		>
	</p>
	<ul class="Reserve-Site-area__Card-area">
		<li>
			<a class="Reserve-Site-area__Card-area__card" href={href1}>
				<div class="Reserve-Site-area__Card-area__card__content">
					<p
						class="Reserve-Site-area__Card-area__card__title"
						set:html={title1}
					/>
				</div>

				<div class="Reserve-Site-area__Card-area__card__button-area">
					<div class="Reserve-Site-area__Card-area__card__btn">
						<img
							class="Reserve-Site-area__Card-area__card__btn-icon"
							src="/src/assets/SVG/white-arrow.svg"
							alt=""
						/>
					</div>
				</div>
			</a>
		</li>

		<li>
			<a class="Reserve-Site-area__Card-area__card" href={href2}>
				<div class="Reserve-Site-area__Card-area__card__content">
					<p
						class="Reserve-Site-area__Card-area__card__title"
						set:html={title2}
					/>
				</div>

				<div class="Reserve-Site-area__Card-area__card__button-area">
					<div class="Reserve-Site-area__Card-area__card__btn">
						<img
							class="Reserve-Site-area__Card-area__card__btn-icon"
							src="/src/assets/SVG/white-arrow.svg"
							alt=""
						/>
					</div>
				</div>
			</a>
		</li>

		<li>
			<a class="Reserve-Site-area__Card-area__card" href={href3}>
				<div class="Reserve-Site-area__Card-area__card__content">
					<p
						class="Reserve-Site-area__Card-area__card__title"
						set:html={title3}
					/>
				</div>

				<div class="Reserve-Site-area__Card-area__card__button-area">
					<div class="Reserve-Site-area__Card-area__card__btn">
						<img
							class="Reserve-Site-area__Card-area__card__btn-icon"
							src="/src/assets/SVG/white-arrow.svg"
							alt=""
						/>
					</div>
				</div>
			</a>
		</li>
	</ul>
</div>
