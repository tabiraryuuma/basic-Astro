---
import "../styles/components/_ReserveLink-area.scss";
import * as CommonIcons from "../assets/SVG";

interface Props {
	text?: string;
	title1?: string;
	// title2?: string;
	title2_1?: string;
	title2_2?: string;
	title3?: string;
	href1?: string;
	href2?: string;
	href3?: string;
	variant?: string;
}

const {
	text = "テキスト",
	title1 = "Airbnb",
	// title2 = "Rakuten Oyado",
	title2_1 = "Rakuten",
	title2_2 = "Oyado",
	title3 = "Booking.com",
	href1 = "#",
	href2 = "#",
	href3 = "#",
	variant = "",
}: Props = Astro.props;
---

<!-- テキスト・見出しエリア -->
<div class={`Reserve-Site-area Reserve-Site-area--${variant}`}>
	<div class={`Reserve-Site-area__text Reserve-Site-area__text--${variant}`}>
		<h3
			class={`Reserve-Site-area__decoration Reserve-Site-area__decoration--${variant}`}
		>
			<span class="span-1">Reserve</span><span class="span-2" aria-hidden="true"
			></span><span class="span-3">予約</span>
		</h3>
	</div>
	<p class={`Reserve-Site-area__text-2 Reserve-Site-area__text-2--${variant}`}>
		<span class="Reserve-Site-area__pc-only"
			>{text} のご予約は下記リンク、予約サイトより。</span
		>
		<span class="Reserve-Site-area__sp-only"
			>{text} のご予約は<br />下記リンク、予約サイトより。</span
		>
		<span class="Reserve-Site-area__br">詳細は各サイトにてご確認ください。</span
		>
	</p>

	<!-- カード三種 -->

	<!-- <div class="Reserve-Site-area__Card-area"> 変更前コード　div削除 ul追加-->
	<ul class="Reserve-Site-area__Card-area">
		<!-- liの追加 -->
		<li class="card-width">
			<a class="Reserve-Site-area__Card-area__card" href={href1}>
				<div class="Reserve-Site-area__Card-area__card__content">
					<p class="Reserve-Site-area__Card-area__card__title">{title1}</p>
				</div>
				<div class="Reserve-Site-area__Card-area__card__button-area">
					<div class="Reserve-Site-area__Card-area__card__btn">
						<img
							class="Reserve-Site-area__Card-area__card__btn-icon Reserve-Site-area__Card-area__card__btn-icon--transitionA arrow"
							src={CommonIcons.WhiteArrow.src}
							alt=""
						/>
						<img
							class="Reserve-Site-area__Card-area__card__btn-icon Reserve-Site-area__Card-area__card__btn-icon--transitionB arrow"
							src={CommonIcons.WhiteArrow.src}
							alt=""
						/>
					</div>
				</div>
			</a>
		</li>

		<!-- liの追加 -->
		<li class="card-width">
			<a class="Reserve-Site-area__Card-area__card" href={href2}>
				<div class="Reserve-Site-area__Card-area__card__content">
					<p class="Reserve-Site-area__Card-area__card__title">
						<span class="span-1">{title2_1}</span><span class="span-2"
							>{title2_2}</span
						>
					</p>
				</div>
				<div class="Reserve-Site-area__Card-area__card__button-area">
					<div class="Reserve-Site-area__Card-area__card__btn">
						<img
							class="Reserve-Site-area__Card-area__card__btn-icon Reserve-Site-area__Card-area__card__btn-icon--transitionA arrow"
							src={CommonIcons.WhiteArrow.src}
							alt=""
						/>
						<img
							class="Reserve-Site-area__Card-area__card__btn-icon Reserve-Site-area__Card-area__card__btn-icon--transitionB arrow"
							src={CommonIcons.WhiteArrow.src}
							alt=""
						/>
					</div>
				</div>
			</a>
		</li>

		<!-- liの追加 -->
		<li class="card-width">
			<a class="Reserve-Site-area__Card-area__card" href={href3}>
				<div class="Reserve-Site-area__Card-area__card__content">
					<p class="Reserve-Site-area__Card-area__card__title">{title3}</p>
				</div>
				<div class="Reserve-Site-area__Card-area__card__button-area">
					<div class="Reserve-Site-area__Card-area__card__btn">
						<img
							class="Reserve-Site-area__Card-area__card__btn-icon Reserve-Site-area__Card-area__card__btn-icon--transitionA arrow"
							src={CommonIcons.WhiteArrow.src}
							alt=""
						/>
						<img
							class="Reserve-Site-area__Card-area__card__btn-icon Reserve-Site-area__Card-area__card__btn-icon--transitionB arrow"
							src={CommonIcons.WhiteArrow.src}
							alt=""
						/>
					</div>
				</div>
			</a>
		</li>
	</ul>
</div>
