---
// src/components/Card.astro
import '../styles/components/_card.scss';

interface Props {
  title?: string;
  href?: string;
}

const {
  title = "カードタイトル",
  href = "#"
}: Props = Astro.props;
---

<div class="card">
  <div class="card__content">
    <p class="card__title" set:html={title}></p>
  </div>

     <!-- 右下のボタンエリア -->
  <div class="card__button-area">
    <a class="card__btn" href={href}>
      <img class="card__btn-icon" src="/src/assets/SVG/white-arrow.svg" alt="">
    </a>
  </div>
</div>

