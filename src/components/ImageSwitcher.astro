---
/**
 * ImageSwitcher.astro
 * HTML・JS・scss
 * 朝 / 夜 トグルスイッチコンポーネント。
 *
 * ■ 作り方: CSS-only（checkbox の :checked でアニメーション制御）
 * ■ デザイン: 旧バージョン（茶系トラック、白Thumb、左に太陽・右に月）
 * ■ JS: body.is-night クラス切替 + 画像 src 切替のみ
 */
import '../styles/components/_ImageSwitcher.scss';
---

<!-- トグルスイッチ -->
<label class="switch" id="dayNightToggle">
  <!-- checkbox がトラック本体（appearance: none でカスタマイズ） -->
   <input class="switch__input" type="checkbox" role="switch" id="switchInput">

  <!-- △仮 --><!-- 太陽アイコン（トラック左側に配置） -->  
  <span class="switch__icon switch__icon--day" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
      <circle cx="12" cy="12" r="5" />
      <line x1="12" y1="1" x2="12" y2="3" />
      <line x1="12" y1="21" x2="12" y2="23" />
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
      <line x1="1" y1="12" x2="3" y2="12" />
      <line x1="21" y1="12" x2="23" y2="12" />
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
    </svg>
  </span>

  <!-- △仮 --><!-- 月アイコン（トラック右側に配置） -->
  <span class="switch__icon switch__icon--night" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
    </svg>
  </span>

  <!-- スクリーンリーダー用ラベル -->
  <span class="switch__sr">朝と夜の表示を切り替える</span>
  <!-- トラック下のラベル表示 -->
  <span class="switch__label" id="switchLabel">DAYTIME</span>

</label>

<script>
  /**
   * JS の役割は2つだけ:
   * 1. body に .is-night クラスを切り替える
   * 2. data-day-src / data-night-src を元に画像の src を切り替える
   */
  document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('switchInput') as HTMLInputElement;
    const label = document.getElementById('switchLabel');
    if (!input || !label)return;

    input.addEventListener('change', () => {
      const isNight = input.checked;

      // body に .is-night クラスを切り替え
      document.body.classList.toggle('is-night', isNight)

      // ラベルテキストを切り替え
      label.textContent = isNight ? 'NIGHTTIME' : 'DAYTIME';

      // 画像切り替え処理
      switchImages(isNight);
    });
  });

  /** data-day-src / data-night-src を元に全画像の src を切り替える */
  function switchImages(isNight: boolean):void {
    const images = document.querySelectorAll<HTMLImageElement>('[data-day-src]');

      images.forEach((img) => {
        const newSrc = isNight ? img.dataset.nightSrc : img.dataset.daySrc;

        if(newSrc && newSrc !== img.src) {
          img.style.opacity = '0';
          setTimeout(() => {
            img.src = newSrc;
            img.style.opacity = '1';
          },200);
        }
     });
    }
</script>
<style lang="scss">
  




